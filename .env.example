# Copy this file to .env for local use. Never commit .env.
# Shell/CI variables take precedence over values in this file.

# Local workboard server
CODEX_TASKBOARD_HOST=127.0.0.1
CODEX_TASKBOARD_PORT=47823
# CODEX_TASKBOARD_DATA_DIR=/absolute/path/to/taskboard-data

# Codex executable used for the embedded AI chat
# CODEX_EXECUTABLE=codex

# Gitee Team CLI used for Tomato sync and status transitions.
# Install/login the CLI separately; do not put a token in this file.
TOMATO_CLI_EXECUTABLE=gitee
# Optional Tomato connection defaults. Leave context/tenant empty until configured.
TOMATO_HOST=https://osc.gitee.work
# TOMATO_PROFILE=osc
# TOMATO_CONTEXT=<your-context>
# TOMATO_TENANT=<your-tenant>

# Optional override for the Tomato Bug analysis repository order.
# If omitted, the current Codex local-project repositories are used automatically.
# TOMATO_ANALYSIS_REPOSITORIES=/absolute/path/to/repository-a,/absolute/path/to/repository-b
